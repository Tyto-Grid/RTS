{
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/survey.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "solarvista.tech"
        }
      ],
      "destination": "/yemmiganur-office",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/yemmiganur/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/yemmiganur/config.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ]
}